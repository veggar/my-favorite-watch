# ── Google OAuth (Google Cloud Console에서 발급) ──────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth 콜백 URI (Cloud Run: https://<service>-xxx.run.app/auth/callback)
REDIRECT_URI=http://localhost:8090/auth/callback

# ── Flask ────────────────────────────────────────────────────────────────
# 임의의 긴 무작위 문자열 (예: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_flask_secret_key

# ── TMDb (선택 사항 - 없으면 자동 링크 연결 생략) ──────────────────────────
TMDB_API_KEY=

# ── 실행 환경 ─────────────────────────────────────────────────────────────
# development / production (기본값: production)
APP_ENV=development

# ── 선택 튜닝 값 (미설정 시 기본값 사용) ───────────────────────────────────
# Flask 세션 쿠키 수명(시간). 기본 12.
# 장기 로그인 유지는 device_id 쿠키(90일) + Firestore가 담당하므로 짧게 둔다.
# SESSION_LIFETIME_HOURS=12

# 한 요청에서 동기 처리할 TMDb 보강 항목 수. 기본 15.
# 늘리면 요청 시간이 길어져 gunicorn --timeout 을 함께 검토해야 한다.
# TMDB_ENRICH_CHUNK=15
