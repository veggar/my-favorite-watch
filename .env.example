# ── Google OAuth (Google Cloud Console에서 발급) ──────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth 콜백 URI
# 로컬: http://localhost:8090/auth/callback
# 운영: https://mfw.worldapex.studio/auth/callback
# (배포 시에는 scripts/deploy.sh 가 PUBLIC_BASE_URL 기준으로 자동 대체한다)
REDIRECT_URI=http://localhost:8090/auth/callback

# ── Flask ────────────────────────────────────────────────────────────────
# 임의의 긴 무작위 문자열 (예: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_flask_secret_key

# ── 사용자 식별 키(HMAC) ─────────────────────────────────────────────────
# 내부 사용자 키 = "v1_" + BASE64URL(HMAC-SHA-256(이 키, 검증된 Google sub))
# - 최소 32바이트. FLASK_SECRET_KEY 와 절대 같은 값을 쓰지 않는다.
# - 운영에서는 이 파일이 아니라 Secret Manager 로만 주입한다(scripts/deploy.sh).
# - 값이 바뀌면 모든 사용자의 user_key 가 바뀌어 기존 시트 연결이 끊긴다.
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
USER_KEY_HMAC_SECRET=

# ── TMDb (선택 사항 - 없으면 자동 링크 연결 생략) ──────────────────────────
TMDB_API_KEY=

# ── 개인정보처리방침 · 이용약관 운영 주체 정보 (P0-4) ──────────────────────
# 운영자명·연락처는 개인정보이므로 코드에 하드코딩하지 않고 여기서 주입한다.
# 미설정 시 /privacy, /terms 화면에 "[운영 주체 미설정]" 등 자리표시자가
# 노출되고 설정 화면·배포 스크립트에 경고가 표시된다. Google OAuth 앱 검증
# (P0-2) 제출 전에는 반드시 채워야 한다.
SERVICE_OPERATOR=
PRIVACY_CONTACT_EMAIL=
SERVICE_URL=https://mfw.worldapex.studio
POLICY_EFFECTIVE_DATE=

# ── 실행 환경 ─────────────────────────────────────────────────────────────
# development / production (기본값: production)
APP_ENV=development

# ── 배포 (scripts/deploy.sh 에서만 사용) ───────────────────────────────────
# 서비스 공개 주소. 기본값은 커스텀 도메인.
# 도메인 매핑 없이 Cloud Run 기본 URL로 배포하려면 그 값으로 덮어쓴다.
# PUBLIC_BASE_URL=https://mfw.worldapex.studio
# GOOGLE_CLOUD_PROJECT=my-favorite-watch
# CLOUD_RUN_REGION=asia-northeast3

# ── 선택 튜닝 값 (미설정 시 기본값 사용) ───────────────────────────────────
# access token 계층의 신선도(시간). 기본 12.
# 세션 쿠키(__session) 수명은 90일 고정이며, 이 값을 넘기면 쿠키 안의
# access token만 폐기하고 Firestore refresh token으로 재발급한다.
# 미설정 시 구 변수 SESSION_LIFETIME_HOURS 값을 사용한다.
# AUTH_FRESHNESS_HOURS=12

# 한 요청에서 동기 처리할 TMDb 보강 항목 수. 기본 15.
# 늘리면 요청 시간이 길어져 gunicorn --timeout 을 함께 검토해야 한다.
# TMDB_ENRICH_CHUNK=15
