# ── Google OAuth (Google Cloud Console에서 발급) ──────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth 콜백 URI
# 로컬: http://localhost:8090/auth/callback
# 운영: https://mfw.worldapex.studio/auth/callback
# (배포 시에는 scripts/deploy.sh 가 PUBLIC_BASE_URL 기준으로 자동 대체한다)
REDIRECT_URI=http://localhost:8090/auth/callback

# ── Flask ────────────────────────────────────────────────────────────────
# 임의의 긴 무작위 문자열 (예: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_flask_secret_key

# ── TMDb (선택 사항 - 없으면 자동 링크 연결 생략) ──────────────────────────
TMDB_API_KEY=

# ── 실행 환경 ─────────────────────────────────────────────────────────────
# development / production (기본값: production)
APP_ENV=development

# ── 배포 (scripts/deploy.sh 에서만 사용) ───────────────────────────────────
# 서비스 공개 주소. 기본값은 커스텀 도메인.
# 도메인 매핑 없이 Cloud Run 기본 URL로 배포하려면 그 값으로 덮어쓴다.
# PUBLIC_BASE_URL=https://mfw.worldapex.studio
# GOOGLE_CLOUD_PROJECT=my-favorite-watch
# CLOUD_RUN_REGION=asia-northeast3

# ── 선택 튜닝 값 (미설정 시 기본값 사용) ───────────────────────────────────
# Flask 세션 쿠키 수명(시간). 기본 12.
# 장기 로그인 유지는 device_id 쿠키(90일) + Firestore가 담당하므로 짧게 둔다.
# SESSION_LIFETIME_HOURS=12

# 한 요청에서 동기 처리할 TMDb 보강 항목 수. 기본 15.
# 늘리면 요청 시간이 길어져 gunicorn --timeout 을 함께 검토해야 한다.
# TMDB_ENRICH_CHUNK=15
